{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["app/**/*.ts", "app/**/*.tsx"],
  "entryPointStrategy": "expand",
  "out": "docs",
  "theme": "default",
  "name": "Priolist",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeExternals": true,
  "skipErrorChecking": true,
  "readme": "README.md"
}
