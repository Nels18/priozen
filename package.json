{
  "name": "priolist",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest run --changed --coverage",
    "commit": "czg",
    "lint:commit": "commitlint --edit $1",
    "prepare": "husky",
    "version": "npx auto-changelog -p && git add CHANGELOG.md",
    "docs": "typedoc"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.27",
    "expo-constants": "~55.0.16",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.15",
    "expo-image": "~55.0.11",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.16",
    "expo-splash-screen": "~55.0.22",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.19",
    "expo-web-browser": "~55.0.17",
    "fast-text-encoding": "^1.0.6",
    "nativewind": "^4.1.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/react": "~19.2.10",
    "@vitest/coverage-v8": "^4.1.5",
    "auto-changelog": "^2.5.0",
    "cz-git": "^1.12.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "msw": "^2.13.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.0.0-insiders.f7d2598",
    "typedoc": "^0.28.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.0",
    "validate-branch-name": "^1.3.2",
    "vitest": "^4.1.5"
  },
  "private": true,
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
